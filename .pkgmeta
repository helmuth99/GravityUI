package-as: GravityUI

ignore:
  - ".git"
  - ".github"
  - ".gitignore"
  - "*.md"
  - "*.textile"
  - "Makefile"

externals:
  GravityUI/Libs/AceAddon-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceAddon-3.0
  GravityUI/Libs/AceComm-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceComm-3.0
  GravityUI/Libs/AceConsole-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceConsole-3.0
  GravityUI/Libs/AceDB-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceDB-3.0
  GravityUI/Libs/AceEvent-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceEvent-3.0
  GravityUI/Libs/AceLocale-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceLocale-3.0
  GravityUI/Libs/AceSerializer-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceSerializer-3.0
  GravityUI/Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  GravityUI/Libs/LibCustomGlow-1.0: https://github.com/Stanzilla/LibCustomGlow
  GravityUI/Libs/LibDeflate: https://github.com/SafeteeWoW/LibDeflate
  GravityUI/Libs/LibDualSpec-1.0: https://repos.curseforge.com/wow/libdualspec-1-0
  GravityUI/Libs/LibKeyBound-1.0: https://repos.curseforge.com/wow/libkeybound-1-0/trunk
  GravityUI/Libs/LibOpenRaid: https://github.com/Tercioo/Open-Raid-Library
  GravityUI/Libs/LibSharedMedia-3.0: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  GravityUI/Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk

move-folders:
  GravityUI/GravityUI: GravityUI

required-dependencies:
  - ellesmereui
  - bigwigs
  - blizzmove
