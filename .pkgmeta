package-as: GravityUI

ignore:
  - ".git"
  - ".github"
  - ".gitignore"
  - "*.md"
  - "*.textile"
  - "Makefile"

externals:
    GravityUI/Libs/Ace3:
        url: https://repos.curseforge.com/wow/ace3/trunk
    GravityUI/Libs/CallbackHandler-1.0:
        url: https://repos.wowace.com/wow/callbackhandler/trunk
    GravityUI/Libs/LibSharedMedia-3.0:
        url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk
    GravityUI/Libs/LibDualSpec-1.0:
        url: https://github.com/AdiAddons/LibDualSpec-1.0
    GravityUI/Libs/LibDeflate:
        url: https://github.com/Safetee/LibDeflate
    GravityUI/Libs/LibCustomGlow-1.0:
        url: https://github.com/Gethe/LibCustomGlow
    GravityUI/Libs/LibKeyBound-1.0:
        url: https://repos.wowace.com/wow/libkeybound-1-0/trunk
    GravityUI/Libs/LibOpenRaid:
        url: https://github.com/Tercioo/Open-Raid-Library
    GravityUI/Libs/LibStub:
        url: https://repos.wowace.com/wow/libstub/trunk

move-folders:
  GravityUI: GravityUI

required-dependencies:
  - unhaltedunitframes
  - danders-frames
  - bettercooldownmanager
  - big-wigs
  - details
  - plater-nameplates
  - blizzmove
