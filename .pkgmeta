package-as: GravityUI

ignore:
  - "*.md"
  - "*.textile"
  - ElvUI_Libraries/Core/LibStub/tests
  - Makefile
  - .gitignore
  - .github/*

move-folders:
  GravityUI/GravityUI: GravityUI

required-dependencies:
  - unhaltedunitframes
  - danders-frames
  - bettercooldownmanager
  - big-wigs
  - details
  - plater-nameplates

optional-dependencies:
  - blizzmove
